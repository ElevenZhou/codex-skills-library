{
  "version": 1,
  "common_properties": {
    "session_id": "string",
    "app_version": "string",
    "platform": {"type": "enum", "values": ["android", "ios", "web"]},
    "install_day": "int",
    "client_ts": "timestamp"
  },
  "events": [
    {"name": "app_open", "description": "App cold or warm start.",
     "properties": {"is_cold_start": "bool", "load_ms": "int"},
     "required": ["is_cold_start"]},
    {"name": "tutorial_start", "description": "Player enters the tutorial.",
     "properties": {}},
    {"name": "tutorial_step", "description": "A tutorial step is completed.",
     "properties": {"step_id": "int", "duration_ms": "int"},
     "required": ["step_id"]},
    {"name": "tutorial_complete", "description": "Tutorial finished.",
     "properties": {"duration_ms": "int"}},
    {"name": "level_start", "description": "A level or round begins.",
     "properties": {"level_id": "int", "attempt": "int", "mode": {"type": "enum", "values": ["normal", "challenge"]}},
     "required": ["level_id", "attempt"]},
    {"name": "level_complete", "description": "Level finished successfully.",
     "properties": {"level_id": "int", "attempt": "int", "duration_ms": "int", "score": "int", "stars": "int"},
     "required": ["level_id", "attempt", "duration_ms"]},
    {"name": "level_fail", "description": "Level failed or abandoned by the game rules.",
     "properties": {"level_id": "int", "attempt": "int", "duration_ms": "int",
                    "reason": {"type": "enum", "values": ["out_of_moves", "timeout", "quit"]}},
     "required": ["level_id", "attempt", "reason"]},
    {"name": "currency_change", "description": "Soft/hard currency balance changes.",
     "properties": {"currency": {"type": "enum", "values": ["coin", "gem"]}, "amount": "int", "balance_after": "int",
                    "source": "string"},
     "required": ["currency", "amount", "source"]},
    {"name": "ad_request", "description": "An ad is requested.",
     "properties": {"placement": "string", "ad_type": {"type": "enum", "values": ["rewarded", "interstitial", "banner"]}},
     "required": ["placement", "ad_type"]},
    {"name": "ad_impression", "description": "An ad was shown to the player.",
     "properties": {"placement": "string", "ad_type": {"type": "enum", "values": ["rewarded", "interstitial", "banner"]},
                    "revenue_usd": "float"},
     "required": ["placement", "ad_type"]},
    {"name": "ad_reward_granted", "description": "Rewarded ad completed and reward given.",
     "properties": {"placement": "string", "reward_type": "string"},
     "required": ["placement"]},
    {"name": "purchase_complete", "description": "In-app purchase confirmed and delivered.",
     "properties": {"product_id": "string", "price_usd": "float", "is_first_purchase": "bool"},
     "required": ["product_id", "price_usd"]},
    {"name": "daily_reward_claim", "description": "Daily login reward claimed.",
     "properties": {"streak_day": "int"},
     "required": ["streak_day"]},
    {"name": "settings_change", "description": "Player changed a setting.",
     "properties": {"setting": "string", "value": "string"}}
  ],
  "funnel": ["app_open", "tutorial_start", "tutorial_complete", "level_start", "level_complete",
             "ad_impression", "purchase_complete"]
}
